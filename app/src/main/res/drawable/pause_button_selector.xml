<?xml version="1.0" encoding="utf-8"?>
<!-- Pause while running, play while paused, swapped at once: a morph between them is a run of
     half-drawn frames on E Ink. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/ic_pause_24px" android:state_checked="true" />
    <item android:drawable="@drawable/ic_play_arrow_24px" />
</selector>
