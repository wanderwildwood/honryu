<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="App.Components.FloatingActionButton.Menu" parent="Widget.Material3.PopupMenu">
        <item name="popupMenuBackground">@drawable/fab_menu_background</item>
        <item name="textAppearanceSmallPopupMenu">
            @style/App.Components.FloatingActionButton.Menu.Text
        </item>
        <item name="textAppearanceLargePopupMenu">
            @style/App.Components.FloatingActionButton.Menu.Text
        </item>
        <item name="iconTint">?attr/colorOnSecondaryContainer</item>
        <item name="android:popupElevation">0dp</item>
    </style>

    <style name="App.Components.ListItem" parent="Widget.Material3.CardView.Outlined">
        <item name="strokeWidth">0dp</item>
        <item name="cardBackgroundColor">@android:color/transparent</item>
        <item name="checkedIcon">@null</item>
    </style>

    <style name="App.Components.ListItem.Label" parent="TextAppearance.Material3.BodyLarge" />

    <style name="App.Components.ListItem.SupportingText" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <style name="App.Components.FloatingActionButton.Menu.Text" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">?attr/colorOnSecondaryContainer</item>
    </style>

    <style name="App.Components.ErrorReportDialog.StackTrace" parent="TextAppearance.Material3.BodySmall">
        <item name="android:typeface">monospace</item>
    </style>

    <style name="App.Components.MaterialCard.Filled.SurfaceVariant" parent="Widget.Material3.CardView.Filled">
        <item name="android:backgroundTint">?attr/colorSurfaceContainer</item>
    </style>

    <style name="MaterialAlertDialog.App.Body.Text" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
    </style>

    <style name="Widget.App.SearchBar" parent="Widget.Material3.SearchBar">
        <item name="elevation">0dp</item>
    </style>

    <!-- TopAppBarMMD: 64dp, titleLarge (24sp Lato), white. The rule beneath is
         layout/top_bar_rule under each bar. -->
    <style name="Widget.App.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:minHeight">@dimen/top_bar_height</item>
        <item name="android:background">@android:color/white</item>
        <item name="titleTextAppearance">@style/TextAppearance.App.TitleLarge</item>
        <item name="contentInsetStartWithNavigation">0dp</item>
    </style>

    <style name="Widget.App.AppBarLayout" parent="Widget.Material3.AppBarLayout">
        <item name="elevation">0dp</item>
    </style>

    <style name="Preference.App.SwitchPreferenceCompat" parent="Preference.SwitchPreferenceCompat.Material">
        <item name="widgetLayout">@layout/pref_widget_switch</item>
    </style>

    <style name="Preference.App.DialogPreference.EditTextPreference" parent="Preference.DialogPreference.EditTextPreference.Material">
        <item name="android:dialogLayout">@layout/pref_widget_dialog_edittext</item>
    </style>

    <style name="App.Components.SwitchBar" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:padding">24dp</item>
    </style>

    <style name="TextAppearance.App.Components.SwitchBar" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
    </style>

    <style name="TextAppearance.App.SectionTitle" parent="TextAppearance.Material3.TitleSmall" />
    <!-- MMD components, drawn with views. -->

    <!-- The add button: black, flat, white mark. A shadow on this panel is a grey smear. -->
    <style name="Widget.App.FloatingActionButton" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">#000000</item>
        <item name="tint">#FFFFFF</item>
        <item name="elevation">0dp</item>
        <item name="hoveredFocusedTranslationZ">0dp</item>
        <item name="pressedTranslationZ">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="rippleColor">@android:color/transparent</item>
    </style>

    <style name="Widget.App.ExtendedFloatingActionButton" parent="Widget.Material3.ExtendedFloatingActionButton.Icon.Primary">
        <item name="backgroundTint">#000000</item>
        <item name="iconTint">#FFFFFF</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">@android:color/transparent</item>
    </style>

    <!-- Cards keep their edge with a black line, not a tint or a shadow. -->
    <style name="Widget.App.CardView" parent="Widget.Material3.CardView.Outlined">
        <item name="strokeColor">#000000</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
        <item name="rippleColor">@android:color/transparent</item>
    </style>

    <!-- As LinearProgressIndicatorMMD: an outlined bar that fills with black. -->
    <style name="Widget.App.LinearProgressIndicator" parent="Widget.Material3.LinearProgressIndicator">
        <item name="indicatorColor">#000000</item>
        <item name="trackColor">@android:color/transparent</item>
        <item name="trackThickness">8dp</item>
        <item name="trackCornerRadius">4dp</item>
        <item name="indicatorTrackGapSize">0dp</item>
        <item name="trackStopIndicatorSize">0dp</item>
        <item name="android:background">@drawable/mmd_progress_track</item>
    </style>

    <style name="Widget.App.Button.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">#000000</item>
        <item name="strokeWidth">1.5dp</item>
    </style>
    <style name="Widget.App.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@drawable/mmd_nav_bar_background</item>
        <item name="itemBackground">@drawable/mmd_nav_item_background</item>
        <item name="itemActiveIndicatorStyle">@null</item>
        <item name="itemIconTint">#000000</item>
        <item name="itemTextColor">#000000</item>
        <item name="itemRippleColor">@android:color/transparent</item>
        <item name="elevation">0dp</item>
    </style>
    <!-- FilterChipMMD: a 2dp outline when off, solid black with white words when on. -->
    <style name="Widget.App.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/mmd_chip_background</item>
        <item name="android:textColor">@color/mmd_chip_text</item>
        <item name="checkedIconTint">#FFFFFF</item>
        <item name="chipIconTint">@color/mmd_chip_text</item>
        <item name="chipStrokeColor">#000000</item>
        <item name="chipStrokeWidth">2dp</item>
        <item name="rippleColor">@android:color/transparent</item>
    </style>

    <!-- A tonal button would be white on white here, so it takes the outlined form. -->
    <style name="Widget.App.Button.TonalButton" parent="Widget.App.Button.OutlinedButton" />
    <style name="Widget.App.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/mmd_menu_background</item>
        <item name="android:popupElevation">0dp</item>
    </style>

    <style name="Widget.App.PopupMenu.Overflow" parent="Widget.Material3.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/mmd_menu_background</item>
        <item name="android:popupElevation">0dp</item>
    </style>

    <style name="Widget.App.PopupMenu.ListPopupWindow" parent="Widget.Material3.PopupMenu.ListPopupWindow">
        <item name="android:popupBackground">@drawable/mmd_menu_background</item>
        <item name="android:popupElevation">0dp</item>
    </style>
    <style name="Widget.App.NavigationView" parent="Widget.Material3.NavigationView">
        <item name="android:background">@drawable/mmd_drawer_background</item>
        <item name="backgroundTint">@null</item>
        <item name="drawerLayoutCornerSize">0dp</item>
        <item name="elevation">0dp</item>
    </style>
</resources>